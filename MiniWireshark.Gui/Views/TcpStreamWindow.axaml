<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniWireshark.Gui.ViewModels"
        x:Class="MiniWireshark.Gui.Views.TcpStreamWindow"
        x:DataType="vm:TcpStreamWindowViewModel"
        Title="Flux TCP"
        Width="800" Height="640">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8">

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" Text="{Binding Summary}" Opacity="0.8" Margin="0,0,0,8" TextWrapping="Wrap" />

        <!-- Cles TLS : visible seulement pour un flux TLS -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8" Spacing="4" IsVisible="{Binding IsTls}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="520" Watermark="Fichier SSLKEYLOGFILE du navigateur" Text="{Binding KeyLogPath}" />
                <Button Content="Déchiffrer" Command="{Binding DecryptCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding DecryptStatus}" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Bascule d'affichage -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="HTTP" Command="{Binding ShowHttpCommand}" IsVisible="{Binding HasHttp}" />    
            <Button Content="Déchiffré" Command="{Binding ShowDecryptedCommand}" IsVisible="{Binding IsDecrypted}" />
            <Button Content="Résumé TLS" Command="{Binding ShowTlsSummaryCommand}" IsVisible="{Binding IsTls}" />
            <Button Content="Texte" Command="{Binding ShowTextCommand}" />
            <Button Content="Hexdump" Command="{Binding ShowHexCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="4">
            <ItemsControl ItemsSource="{Binding Chunks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding DirectionLabel}"
                                       Foreground="{Binding Foreground}"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Opacity="0.8" />
                            <TextBlock Text="{Binding Text}"
                                       Foreground="{Binding Foreground}"
                                       FontFamily="Consolas,Menlo,monospace"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="5" Content="Fermer" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnCloseClick" />

    </Grid>
</Window>